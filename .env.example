# ==============================================================================
# JIN SANSKAR SETU (जिन संस्कार सेतु) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development.
# In Vercel / Production, configure these variables in your project settings.
# NEVER commit .env to Git — it contains secrets.

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon PostgreSQL)
# Connection string to your PostgreSQL instance.
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (NextAuth — Username + Password, NO Google OAuth)
# Generate AUTH_SECRET via: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ------------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="your-high-entropy-auth-secret-here"
NEXTAUTH_SECRET="your-high-entropy-auth-secret-here"

# ------------------------------------------------------------------------------
# 3. INITIAL ACCOUNTS (used only by `npx prisma db seed`)
# These are read at seed time only. Passwords are bcrypt-hashed before storage.
# Set STRONG passwords — these are the only login credentials until admin changes them.
# Never use default values in production.
# ------------------------------------------------------------------------------

ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-admin-password-here

VOLUNTEER1_USERNAME=volunteer1
VOLUNTEER1_PASSWORD=your-strong-volunteer1-password-here

VOLUNTEER2_USERNAME=volunteer2
VOLUNTEER2_PASSWORD=your-strong-volunteer2-password-here

VOLUNTEER3_USERNAME=volunteer3
VOLUNTEER3_PASSWORD=your-strong-volunteer3-password-here

VOLUNTEER4_USERNAME=volunteer4
VOLUNTEER4_PASSWORD=your-strong-volunteer4-password-here

# ------------------------------------------------------------------------------
# 4. GOOGLE SHEETS SYNC (Optional — application works without these)
# Configure only after core application is working.
# ------------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
