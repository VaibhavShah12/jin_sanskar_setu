// ==============================================================================
// JIN SANSKAR SETU (जिन संस्कार सेतु) - Prisma Schema
// PostgreSQL is the SINGLE SOURCE OF TRUTH
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum Role {
  ADMIN
  VOLUNTEER
  TRUSTEE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum Relationship {
  HEAD
  SPOUSE
  SON
  DAUGHTER
  FATHER
  MOTHER
  BROTHER
  SISTER
  GRANDFATHER
  GRANDMOTHER
  GRANDCHILD
  OTHER
}

enum PathshalaStatus {
  YES
  NO
  PREVIOUSLY_ATTENDED
  UNKNOWN
}

enum PathshalaInterest {
  YES
  MAYBE
  NO
  UNKNOWN
}

enum PreferredDay {
  SATURDAY
  SUNDAY
  WEEKDAY
  NO_PREFERENCE
}

enum PreferredTime {
  MORNING
  AFTERNOON
  EVENING
  NO_PREFERENCE
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum BirthdayMessageStatus {
  SCHEDULED
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

// ------------------------------------------------------------------------------
// USERS
// Only pre-authorized users added by an administrator may access the application.
// ------------------------------------------------------------------------------

model User {
  id                 String      @id @default(cuid())
  username           String      @unique // Unique login username
  passwordHash       String      // bcrypt hashed password
  name               String?
  email              String?     @unique // Optional contact email
  image              String?
  role               Role        @default(VOLUNTEER)
  status             UserStatus  @default(ACTIVE)
  sanghId            String?
  sangh              Sangh?      @relation(fields: [sanghId], references: [id], onDelete: SetNull)
  canExport          Boolean     @default(false)
  mustChangePassword Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  lastLoginAt        DateTime?
  createdBy          String?

  @@index([username])
  @@index([status])
  @@index([sanghId])
  @@map("users")
}

// ------------------------------------------------------------------------------
// SANGHS
// Exactly six sanghs are seeded: MSJS, SAJS, SSJS, SKJS, EJS, NJS
// ------------------------------------------------------------------------------

model Sangh {
  id        String     @id @default(cuid())
  name      String     @unique
  prefix    String     @unique // MSJS, SAJS, SSJS, SKJS, EJS, NJS
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users          User[]
  families       Family[]
  members        Member[]
  idCounter      IdCounter?
  accessRequests MemberAccessRequest[]
  birthdayMessages BirthdayMessageLog[]
  memberFormSubmissions MemberFormSubmission[]

  @@index([prefix])
  @@map("sanghs")
}

// ------------------------------------------------------------------------------
// FAMILIES
// Represents a Jain family unit.
// ------------------------------------------------------------------------------

model Family {
  id               String       @id @default(cuid())
  familyId         String       @unique // e.g., FAM-000001
  headMemberId     String?      // Resolved after head member record is created
  headName         String
  mobile           String
  normalizedMobile String       // Stripped of spaces, hyphens, prefixes
  address          String
  area             String
  sanghId          String
  sangh            Sangh        @relation(fields: [sanghId], references: [id], onDelete: Restrict)
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdBy        String?
  updatedBy        String?

  members                Member[]
  accessRequests         MemberAccessRequest[]
  questionnaireResponses QuestionnaireResponse[]
  birthdayMessages       BirthdayMessageLog[]
  memberFormSubmissions  MemberFormSubmission[]

  @@index([familyId])
  @@index([normalizedMobile])
  @@index([sanghId])
  @@index([area])
  @@index([status])
  @@index([normalizedMobile, sanghId])
  @@map("families")
}

// ------------------------------------------------------------------------------
// MEMBERS
// Individual members belonging to a family. Head of family is also a member.
// ------------------------------------------------------------------------------

model Member {
  id                String            @id @default(cuid())
  memberId          String            @unique // e.g., MSJS-000001
  familyId          String
  family            Family            @relation(fields: [familyId], references: [id], onDelete: Restrict)
  sanghId           String
  sangh             Sangh             @relation(fields: [sanghId], references: [id], onDelete: Restrict)
  name              String
  normalizedName    String
  dateOfBirth       DateTime?         @db.Date
  age               Int
  gender            Gender
  relationship      Relationship
  pathshalaStatus   PathshalaStatus   @default(UNKNOWN)
  pathshalaInterest PathshalaInterest @default(UNKNOWN)
  preferredDay      PreferredDay      @default(NO_PREFERENCE)
  preferredTime     PreferredTime     @default(NO_PREFERENCE)
  preferredWeekdays String?           // Comma-separated list of selected weekdays if preferredDay is WEEKDAY
  transportPreference String?         // PICK_AND_DROP, BY_SELF
  noInterestReason    String?         // Comment/reason if pathshalaInterest is NO
  status            RecordStatus      @default(ACTIVE)
  interests         String[]          @default([])
  whatsappConsent          Boolean    @default(false)
  whatsappConsentDate      DateTime?
  whatsappConsentSource    String?    // e.g. "SURVEY_FORM", "VOLUNTEER_VERIFIED", "MEMBER_PORTAL", "ADMIN_UPDATE", "TRUSTEE_UPDATE"
  whatsappConsentUpdatedBy String?    // Username of staff who updated consent
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         String?
  updatedBy         String?

  sheetSync              GoogleSheetSync?
  questionnaireResponses QuestionnaireResponse[]
  birthdayMessages       BirthdayMessageLog[]

  @@index([memberId])
  @@index([familyId])
  @@index([sanghId])
  @@index([normalizedName])
  @@index([age])
  @@index([gender])
  @@index([pathshalaStatus])
  @@index([pathshalaInterest])
  @@index([status])
  @@index([createdAt])
  @@index([sanghId, age])
  @@index([sanghId, pathshalaStatus])
  @@index([familyId, normalizedName])
  @@index([whatsappConsent])
  @@map("members")
}

// ------------------------------------------------------------------------------
// ID COUNTERS
// Independent atomic counter per Sangh for member IDs (PREFIX-000001)
// ------------------------------------------------------------------------------

model IdCounter {
  id         String   @id @default(cuid())
  sanghId    String   @unique
  sangh      Sangh    @relation(fields: [sanghId], references: [id], onDelete: Cascade)
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@index([sanghId])
  @@map("id_counters")
}

// ------------------------------------------------------------------------------
// FAMILY ID COUNTER
// Global sequence counter for Family IDs (FAM-000001)
// ------------------------------------------------------------------------------

model FamilyIdCounter {
  id         String   @id @default("GLOBAL_FAMILY_COUNTER")
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("family_id_counters")
}

// ------------------------------------------------------------------------------
// AUDIT LOGS
// Complete immutable audit trail of all operational events
// ------------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // FAMILY_CREATED, FAMILY_ARCHIVED, MEMBER_CREATED, etc.
  entityType  String   // Family, Member, User, Sync, Export
  entityId    String
  performedBy String   // User email or ID
  performedAt DateTime @default(now())
  metadata    Json?    // Contextual payload

  @@index([action])
  @@index([entityType, entityId])
  @@index([performedBy])
  @@index([performedAt])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// GOOGLE SHEET SYNC
// Tracks sync status for each member to the single synchronized Google Sheet.
// Failure does NOT rollback PostgreSQL transactions.
// ------------------------------------------------------------------------------

model GoogleSheetSync {
  id                 String     @id @default(cuid())
  memberId           String     @unique
  member             Member     @relation(fields: [memberId], references: [memberId], onDelete: Cascade)
  status             SyncStatus @default(PENDING)
  sheetRowReference  String?    // Row index or A1 notation in Sheet
  lastAttemptAt      DateTime?
  syncedAt           DateTime?
  errorMessage       String?
  retryCount         Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([status])
  @@index([memberId])
  @@map("google_sheet_sync")
}

// ------------------------------------------------------------------------------
// MEMBER ACCESS REQUESTS
// Tracks self-service access requests submitted by family members via mobile.
// Concurrency-safe: only one volunteer can transition a request to APPROVED.
// ------------------------------------------------------------------------------

model MemberAccessRequest {
  id               String              @id @default(cuid())
  requestId        String              @unique @default(cuid())
  mobile           String
  normalizedMobile String
  familyId         String
  family           Family              @relation(fields: [familyId], references: [id], onDelete: Restrict)
  sanghId          String
  sangh            Sangh               @relation(fields: [sanghId], references: [id], onDelete: Restrict)
  status           AccessRequestStatus @default(PENDING)
  requestToken     String              @unique // Secret token given to requester browser session
  grantToken       String?             @unique // Secret token issued upon volunteer approval
  grantExpiresAt   DateTime?
  approvedBy       String?             // Volunteer/Admin username who approved
  approvedAt       DateTime?
  rejectedBy       String?             // Volunteer/Admin username who rejected
  rejectedAt       DateTime?
  rejectionReason  String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status])
  @@index([normalizedMobile])
  @@index([familyId])
  @@index([sanghId])
  @@index([requestToken])
  @@index([grantToken])
  @@map("member_access_requests")
}

// ------------------------------------------------------------------------------
// QUESTIONNAIRE FRAMEWORK (Extensible schema for future questionnaire rollout)
// Kept separate from original volunteer registration records.
// ------------------------------------------------------------------------------

model Questionnaire {
  id          String                  @id @default(cuid())
  code        String                  @unique // e.g., "SANSKAR_SURVEY_V1"
  title       String
  description String?
  version     Int                     @default(1)
  active      Boolean                 @default(false) // Inactive until questions are supplied
  schema      Json?                   // Extensible question definitions
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  responses   QuestionnaireResponse[]

  @@index([code])
  @@index([active])
  @@map("questionnaires")
}

model QuestionnaireResponse {
  id              String        @id @default(cuid())
  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  familyId        String
  family          Family        @relation(fields: [familyId], references: [id], onDelete: Restrict)
  memberId        String?
  member          Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  response        Json          // Stored questionnaire answers
  submittedBy     String?       // Requester/Member identifier
  submittedAt     DateTime      @default(now())

  @@index([questionnaireId])
  @@index([familyId])
  @@index([memberId])
  @@map("questionnaire_responses")
}

// ------------------------------------------------------------------------------
// WHATSAPP BIRTHDAY MESSAGING LOGS
// Tracks automated birthday message deliveries to family heads.
// Concurrency-safe: Unique constraint on [memberId, birthdayYear] prevents duplicate sends.
// ------------------------------------------------------------------------------

model BirthdayMessageLog {
  id                 String                @id @default(cuid())
  memberId           String
  member             Member                @relation(fields: [memberId], references: [id], onDelete: Restrict)
  familyId           String
  family             Family                @relation(fields: [familyId], references: [id], onDelete: Restrict)
  sanghId            String
  sangh              Sangh                 @relation(fields: [sanghId], references: [id], onDelete: Restrict)
  birthdayYear       Int                   // e.g. 2026
  scheduledDate      DateTime              @db.Date
  recipientName      String
  recipientPhone     String                // Normalized E.164: e.g. +919822012345
  templateName       String
  templateLanguage   String
  status             BirthdayMessageStatus @default(SCHEDULED)
  whatsappMessageId  String?               @unique // Meta message ID: wamid.HBg...
  attemptCount       Int                   @default(0)
  lastAttemptAt      DateTime?
  sentAt             DateTime?
  deliveredAt        DateTime?
  readAt             DateTime?
  failedAt           DateTime?
  failureReason      String?
  skipReason         String?
  responsePayload    Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([memberId, birthdayYear])
  @@index([status])
  @@index([sanghId])
  @@index([scheduledDate])
  @@index([birthdayYear])
  @@index([whatsappMessageId])
  @@map("birthday_message_logs")
}

// ------------------------------------------------------------------------------
// PUBLIC MEMBER FORM SUBMISSIONS
// Stored as separate pending submission records for volunteer validation.
// Directly overwriting verified family records is prevented.
// ------------------------------------------------------------------------------

model MemberFormSubmission {
  id                 String           @id @default(cuid())
  submissionNumber   String           @unique // e.g. SUB-2026-0001
  familyId           String
  family             Family           @relation(fields: [familyId], references: [id], onDelete: Restrict)
  headMemberId       String?
  sanghId            String
  sangh              Sangh            @relation(fields: [sanghId], references: [id], onDelete: Restrict)
  submittedMobile    String           // Normalized mobile number
  submittedHeadName  String

  // 7 specific questions for the family head
  headInfoCorrect    Boolean          @default(true) // Q1
  addressChanged     Boolean          @default(false) // Q2
  newAddress         String?
  newArea            String?
  memberCount        Int              // Q3
  membersUpToDate    Boolean          @default(true) // Q4
  correctionNeeded   Boolean          @default(false) // Q5
  correctionDetails  String?          // Q6
  additionalNotes    String?          // Q7

  status             SubmissionStatus @default(PENDING)
  reviewedBy         String?          // Reviewer username (volunteer / admin)
  reviewedAt         DateTime?
  rejectionReason    String?
  appliedChanges     Json?            // Audit snapshot of applied changes

  ipAddress          String?
  userAgent          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status])
  @@index([submittedMobile])
  @@index([familyId])
  @@index([sanghId])
  @@index([createdAt])
  @@map("member_form_submissions")
}

// ------------------------------------------------------------------------------
// OTP VERIFICATIONS
// Rate-limited, expiring OTP store for public member verification
// ------------------------------------------------------------------------------

model OtpVerification {
  id           String   @id @default(cuid())
  mobile       String   // Normalized mobile (10 digits)
  codeHash     String   // Hashed 6-digit OTP
  sessionToken String   @unique // Cryptographic random token for verified form session
  familyId     String?  // Matched family ID
  attempts     Int      @default(0)
  verified     Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([mobile])
  @@index([sessionToken])
  @@map("otp_verifications")
}

// ------------------------------------------------------------------------------
// SUBMISSION COUNTER
// Concurrency-safe atomic sequence for public member form submissions (SUB-YYYY-XXXX)
// ------------------------------------------------------------------------------

model SubmissionCounter {
  id         String   @id @default("GLOBAL_SUBMISSION_COUNTER")
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("submission_counters")
}


